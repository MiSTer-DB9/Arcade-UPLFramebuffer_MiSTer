set_global_assignment -name SYSTEMVERILOG_FILE rtl/UPLFramebuffer.sv

set_global_assignment -name QIP_FILE rtl/cpu/T80/T80.qip

set_global_assignment -name QIP_FILE rtl/sound/v_sound.qip
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/UPLFramebuffer_MC8123.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/boards/ninjakd2/ninjakd2_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/boards/ninjakd2/UPLFramebuffer_MAIN.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/boards/ninjakd2/UPLFramebuffer_VIDEO.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/boards/ninjakd2/UPLFramebuffer_BGLAYER.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/boards/ninjakd2/UPLFramebuffer_SPRITE.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/boards/ninjakd2/UPLFramebuffer_SND.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/boards/ninjakd2/UPLFramebuffer_PCM.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/boards/nova2001/nova2001_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/boards/xxmissio/xxmissio_board.sv

set_global_assignment -name VERILOG_FILE rtl/mister_custom/hiscore.v
set_global_assignment -name VERILOG_FILE rtl/mister_custom/nvram.v
set_global_assignment -name VERILOG_FILE rtl/mister_custom/pause.v
# CTL-2026-10-25: shared input library (controllers.sv v2)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mister_custom/controllers.sv

# DPRAMSV-2026-10-25: VHDL dpram_dc replaced by the SystemVerilog one (same ports/generics + byteena); original:
# set_global_assignment -name VHDL_FILE rtl/ram_rom/dpram_dc.vhd
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ram_rom/dpram_dc.sv
set_global_assignment -name VHDL_FILE rtl/ram_rom/spram.vhd
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ram_rom/sdram.sv
